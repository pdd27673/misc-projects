{
  "name": "csun-class-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/client/main.ts --bundle --minify --format=esm --target=es2022 --outfile=public/app.js",
    "dev": "esbuild src/client/main.ts --bundle --format=esm --target=es2022 --outfile=public/app.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/node": "^26.1.2",
    "esbuild": "^0.24.0",
    "playwright": "^1.62.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.114.0"
  }
}
